{
  "$schema": "https://unpkg.com/wrangler@latest/config-schema.json",

  "name": "harshit-joshi-site",
  "main": "./worker.js",
  "account_id": "3f99121031dc671e0a9f5810852d8681",
  "workers_dev": false,
  "preview_urls": false,

  "compatibility_date": "2026-08-23",

  "routes": [
    { "pattern": "harshit.quest", "custom_domain": true },
    { "pattern": "www.harshit.quest", "custom_domain": true }
  ],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  }
}
